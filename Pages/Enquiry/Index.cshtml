@page
@model SolarEnergy.Pages.Enquiry.IndexModel
@{
    ViewData["Title"] = "Enquiry";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow p-4">
            <h2 class="text-success mb-3"><i class="fa-solid fa-circle-question"></i> Solar Project / Product Enquiry</h2>
            <p class="text-muted">Apni requirement share karein, hamari expert team aapse turant contact karegi.</p>
            @if (TempData["EnqMsg"] != null) {
                <div class="alert alert-success">@TempData["EnqMsg"]</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" name="Name" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" name="Phone" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-control" name="Email" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Requirement Type</label>
                    <select class="form-control" name="RequirementType">
                        <option value="Rooftop Solar Plant (Home/Office)">Rooftop Solar Plant (Home/Office)</option>
                        <option value="Solar Panels & Inverters">Solar Panels & Inverters</option>
                        <option value="Solar Batteries & Storage">Solar Batteries & Storage</option>
                        <option value="Agricultural Solar Water Pump">Agricultural Solar Water Pump</option>
                        <option value="General Inquiry">General Inquiry</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Details / Message</label>
                    <textarea class="form-control" name="Message" rows="4" placeholder="Apni bijli ki khapat (monthly bill) ya zaroorat yahan likhein..." required></textarea>
                </div>
                <button type="submit" class="btn btn-success w-100">Submit Enquiry</button>
            </form>
        </div>
    </div>
</div>
