@page
@model SolarEnergy.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login / Signup";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-gradient bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <h3 class="fw-bold mb-1"><i class="fa-solid fa-solar-panel me-2"></i> SolarEco Portal</h3>
                <p class="mb-0 small text-white-50">Sign in to your account or register a new one</p>
            </div>
            <div class="card-body p-4 p-md-5">
                @if (TempData["AuthMsg"] != null) {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-info me-2"></i> @TempData["AuthMsg"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-3" id="authTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-3 fw-semibold" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button" role="tab"><i class="fa-solid fa-right-to-bracket me-1"></i> Login</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-3 fw-semibold" id="signup-tab" data-bs-toggle="tab" data-bs-target="#signup" type="button" role="tab"><i class="fa-solid fa-user-plus me-1"></i> Signup</button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabContent">
                    <!-- Login Form -->
                    <div class="tab-pane fade show active" id="login" role="tabpanel">
                        <form method="post" asp-page-handler="Login">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold"><i class="fa-solid fa-envelope me-1 text-muted"></i> Email Address</label>
                                <input type="email" class="form-control rounded-3 py-2" name="Email" placeholder="admin@solareco.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold"><i class="fa-solid fa-lock me-1 text-muted"></i> Password</label>
                                <input type="password" class="form-control rounded-3 py-2" name="Password" placeholder="••••••••" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold shadow-sm"><i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Secure Login</button>
                        </form>
                    </div>

                    <!-- Signup Form -->
                    <div class="tab-pane fade" id="signup" role="tabpanel">
                        <form method="post" asp-page-handler="Signup">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold"><i class="fa-solid fa-user me-1 text-muted"></i> Full Name</label>
                                <input type="text" class="form-control rounded-3 py-2" name="Name" placeholder="Rahul Sharma" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold"><i class="fa-solid fa-envelope me-1 text-muted"></i> Email Address</label>
                                <input type="email" class="form-control rounded-3 py-2" name="Email" placeholder="rahul@gmail.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold"><i class="fa-solid fa-lock me-1 text-muted"></i> Password</label>
                                <input type="password" class="form-control rounded-3 py-2" name="Password" placeholder="••••••••" required />
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-bold shadow-sm"><i class="fa-solid fa-user-check me-1"></i> Create Account</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
