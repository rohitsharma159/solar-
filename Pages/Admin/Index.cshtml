@page
@model SolarEnergy.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 text-white" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="fa-solid fa-gauge-high text-warning me-2"></i> Admin Control Center</h2>
                        <p class="text-white-50 mb-0">Manage products inventory, customer enquiries, user lists, and feedbacks seamlessly.</p>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <span class="badge bg-dark text-warning p-2 fs-6 shadow-sm"><i class="fa-solid fa-user-shield me-1"></i> Admin: admin@solareco.com</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["AdminMsg"] != null) {
        <div class="alert alert-success alert-dismissible fade show shadow-sm bg-success text-white border-0" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["AdminMsg"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-secondary bg-opacity-10 border-start border-primary border-4">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-2 text-primary bg-dark p-3 rounded-4 me-3"><i class="fa-solid fa-solar-panel"></i></div>
                    <div>
                        <h6 class="text-white-50 mb-1">Products</h6>
                        <h3 class="fw-bold mb-0 text-white">@SolarEnergy.Models.DataStore.Products.Count</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-secondary bg-opacity-10 border-start border-success border-4">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-2 text-success bg-dark p-3 rounded-4 me-3"><i class="fa-solid fa-users"></i></div>
                    <div>
                        <h6 class="text-white-50 mb-1">Users</h6>
                        <h3 class="fw-bold mb-0 text-white">@SolarEnergy.Models.DataStore.Users.Count</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-secondary bg-opacity-10 border-start border-warning border-4">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-2 text-warning bg-dark p-3 rounded-4 me-3"><i class="fa-solid fa-circle-question"></i></div>
                    <div>
                        <h6 class="text-white-50 mb-1">Enquiries</h6>
                        <h3 class="fw-bold mb-0 text-white">@SolarEnergy.Models.DataStore.Enquiries.Count</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-secondary bg-opacity-10 border-start border-info border-4">
                <div class="card-body d-flex align-items-center">
                    <div class="fs-2 text-info bg-dark p-3 rounded-4 me-3"><i class="fa-solid fa-comments"></i></div>
                    <div>
                        <h6 class="text-white-50 mb-1">Feedbacks</h6>
                        <h3 class="fw-bold mb-0 text-white">@SolarEnergy.Models.DataStore.Feedbacks.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Product & Management Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold text-white"><i class="fa-solid fa-square-plus text-primary me-2"></i> Add / Update Product</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="SaveProduct">
                        <input type="hidden" name="Id" value="@Model.EditProduct?.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-white-50">Product Name</label>
                            <input type="text" class="form-control rounded-3" name="Name" value="@Model.EditProduct?.Name" placeholder="e.g. Mono Solar Panel 500W" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-white-50">Category</label>
                            <select class="form-select rounded-3" name="Category">
                                <option value="Solar Panels" selected="@(Model.EditProduct?.Category == "Solar Panels")">Solar Panels</option>
                                <option value="Inverters" selected="@(Model.EditProduct?.Category == "Inverters")">Inverters</option>
                                <option value="Batteries" selected="@(Model.EditProduct?.Category == "Batteries")">Batteries</option>
                                <option value="Lighting" selected="@(Model.EditProduct?.Category == "Lighting")">Lighting</option>
                                <option value="Pumps" selected="@(Model.EditProduct?.Category == "Pumps")">Pumps</option>
                                <option value="Accessories" selected="@(Model.EditProduct?.Category == "Accessories")">Accessories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-white-50">Price (₹)</label>
                            <input type="number" step="0.01" class="form-control rounded-3" name="Price" value="@Model.EditProduct?.Price" placeholder="e.g. 14999" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-white-50">Image URL</label>
                            <input type="text" class="form-control rounded-3" name="ImageUrl" value="@Model.EditProduct?.ImageUrl" placeholder="https://images.unsplash.com/..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-white-50">Description</label>
                            <textarea class="form-control rounded-3" name="Description" rows="2" placeholder="Product details...">@Model.EditProduct?.Description</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Save Product</button>
                        @if(Model.EditProduct != null) {
                            <a href="/Admin/Index" class="btn btn-outline-light w-100 mt-2 rounded-3 py-2">Cancel Edit</a>
                        }
                    </form>
                </div>
            </div>
        </div>

        <!-- Products Inventory Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i> All Products Inventory (@SolarEnergy.Models.DataStore.Products.Count)</h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-hover align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Item</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in SolarEnergy.Models.DataStore.Products) {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@p.ImageUrl" class="rounded-3 me-2 object-fit-cover shadow-sm" style="width: 45px; height: 45px;" onerror="this.src='https://images.unsplash.com/photo-1509391365360-e835f377c86a?w=500'" />
                                                <div>
                                                    <span class="fw-semibold d-block text-white">@p.Name</span>
                                                    <small class="text-white-50">ID: @p.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-dark text-light border border-secondary">@p.Category</span></td>
                                        <td class="fw-bold text-success">₹@p.Price.ToString("N0")</td>
                                        <td class="text-end">
                                            <a href="/Admin/Index?editId=@p.Id" class="btn btn-outline-warning btn-sm rounded-3 me-1"><i class="fa-solid fa-pen-to-square"></i></a>
                                            <form method="post" asp-page-handler="DeleteProduct" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                <input type="hidden" name="Id" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-3"><i class="fa-solid fa-trash-can"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enquiries, Users & Feedbacks Tables Row -->
    <div class="row g-4">
        <!-- Enquiries Table -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold text-white mb-0"><i class="fa-solid fa-circle-question text-warning me-2"></i> Customer Enquiries</h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(SolarEnergy.Models.DataStore.Enquiries.Count == 0) {
                                    <tr><td colspan="3" class="text-center text-white-50 py-3">No enquiries yet.</td></tr>
                                } else {
                                    @foreach (var e in SolarEnergy.Models.DataStore.Enquiries) {
                                        <tr>
                                            <td><span class="fw-semibold text-white">@e.CustomerName</span><br/><small class="text-white-50">@e.Email</small></td>
                                            <td class="text-info">@e.Phone</td>
                                            <td><span class="text-white-50 text-truncate d-inline-block" style="max-width: 120px;" title="@e.Message">@e.Message</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registered Users Table -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold text-white mb-0"><i class="fa-solid fa-users text-success me-2"></i> Registered Users</h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in SolarEnergy.Models.DataStore.Users) {
                                    <tr>
                                        <td class="fw-semibold text-white">@u.Name</td>
                                        <td class="text-white-50">@u.Email</td>
                                        <td><span class="badge bg-secondary">@u.Role</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Feedbacks Table -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold text-white mb-0"><i class="fa-solid fa-comments text-info me-2"></i> Customer Feedbacks</h5>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th>Rating</th>
                                    <th>Comments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(SolarEnergy.Models.DataStore.Feedbacks.Count == 0) {
                                    <tr><td colspan="3" class="text-center text-white-50 py-3">No feedback submitted yet.</td></tr>
                                } else {
                                    @foreach (var f in SolarEnergy.Models.DataStore.Feedbacks) {
                                        <tr>
                                            <td class="fw-semibold text-white">@f.CustomerName</td>
                                            <td><span class="badge bg-warning text-dark">@f.Rating / 5 ★</span></td>
                                            <td><span class="text-white-50 text-truncate d-inline-block" style="max-width: 120px;" title="@f.Comments">@f.Comments</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
